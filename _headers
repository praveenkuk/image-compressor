# Cloudflare Pages response headers for compresspixel.com
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Images: cache for 30 days (rename a file if you replace its picture)
/assets/*
  Cache-Control: public, max-age=2592000

# CSS and JS keep the same file names when edited, so cache for 1 day only
/styles/*
  Cache-Control: public, max-age=86400
/scripts/*
  Cache-Control: public, max-age=86400

# Third-party library files never change: cache for 1 year
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
